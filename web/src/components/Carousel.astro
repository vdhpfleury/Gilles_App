---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  images: { src: ImageMetadata; alt: string }[];
  height?: string;
  duration?: number;
}

const { id, images, height = '420px', duration = 4 } = Astro.props;
const count = images.length;
const total = count * duration;
const visiblePct = 100 / count;
const fadeInPct = (visiblePct * 0.18).toFixed(2);
const holdEndPct = (visiblePct * 0.82).toFixed(2);
const fadeOutPct = visiblePct.toFixed(2);
const keyframeName = `carousel-fade-${id}`;

const css = `
@keyframes ${keyframeName} {
  0% { opacity: 0; }
  ${fadeInPct}% { opacity: 1; }
  ${holdEndPct}% { opacity: 1; }
  ${fadeOutPct}% { opacity: 0; }
  100% { opacity: 0; }
}`;
---

<div class="relative overflow-hidden rounded-lg bg-ink" style={`height: ${height};`}>
  {images.map((img, i) => (
    <Image
      src={img.src}
      alt={img.alt}
      class="absolute inset-0 h-full w-full object-cover opacity-0"
      style={`animation: ${keyframeName} ${total}s infinite; animation-delay: ${i * duration}s;`}
      loading={i === 0 ? 'eager' : 'lazy'}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1024px) 50vw, 100vw"
    />
  ))}
</div>
<style is:inline set:html={css} />
