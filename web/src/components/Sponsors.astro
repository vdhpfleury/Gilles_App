---
/*
 * Bande « Partenaires » en bas du hero (accueil), sous le contact et les réseaux sociaux :
 * logos ivoire posés sur la photo assombrie, sans cartouche, atténués au repos et à pleine
 * opacité au survol ou au focus, dans quatre cellules identiques sur une rangée. Entre avec le
 * reste du hero (data-hero-item). Liste, liens et réglages : src/data/sponsors.ts.
 * Survol / focus clavier : le logo visé ressort (les autres s'estompent), un reflet le
 * traverse, un trait et la mention « Site officiel » apparaissent dessous ; en tactile, le
 * reflet passe une fois sur chaque logo après l'entrée du hero. Tout est en CSS (plus bas).
 */
import { getImage } from 'astro:assets';
import { sponsors } from '../data/sponsors';

// Côté (px) d'un logo carré à partir de md (--logo-unit, 3.5rem) ; en dessous, 2.25rem pour tenir
// à quatre sur une rangée dès 375 px. Donne les attributs width/height (aucun décalage de mise
// en page) et les largeurs des images générées.
const UNIT = 56;
const UNIT_MOBILE = 36;

// Taille optique commune : même aire pour tous les logos (largeur ∝ √ratio, hauteur ∝ 1/√ratio),
// corrigée par `echelle`. À partir de md, la hauteur CSS (--logo-unit × --logo-h) tombe
// exactement sur l'attribut height : l'image 1x s'affiche pixel pour pixel. Images générées : 1x
// et 2x des largeurs mobile et desktop (la 2x desktop sert aux écrans 3x en mobile) ; `sizes`
// laisse le navigateur prendre la plus petite qui suffit.
const logos = await Promise.all(
  sponsors.map(async (sponsor) => {
    const ratio = sponsor.logo.width / sponsor.logo.height;
    const width = Math.round(UNIT * (sponsor.echelle ?? 1) * Math.sqrt(ratio));
    const height = Math.round(width / ratio);
    const mobileWidth = Math.round((width * UNIT_MOBILE) / UNIT);
    // Ce que rendrait <Image> (mêmes options, donc mêmes fichiers), mais avec les URL sous la
    // main pour le masque du reflet (plus bas). Dans le premier écran : chargement immédiat, mais
    // en priorité basse pour ne jamais concurrencer la photo du hero (élément LCP, en priorité
    // haute).
    const image = await getImage({
      src: sponsor.logo,
      alt: sponsor.nom,
      width,
      height,
      widths: [mobileWidth, width, 2 * mobileWidth, 2 * width],
      sizes: `(min-width: 48rem) ${width}px, ${mobileWidth}px`,
      loading: 'eager',
      fetchpriority: 'low',
    });
    // Masque du reflet : les mêmes variantes, en image-set() avec leur densité réelle à la taille
    // affichée (mobile, puis à partir de md). Le navigateur y prend la même image que dans le
    // srcset, déjà téléchargée : aucun octet de plus.
    const maskAt = (displayWidth: number) =>
      `image-set(${image.srcSet.values
        .map(({ url, transform }) => `url('${url}') ${+((transform.width ?? displayWidth) / displayWidth).toFixed(3)}x`)
        .join(', ')})`;
    return {
      ...sponsor,
      image,
      h: height / UNIT,
      mask: `--mask: ${maskAt(mobileWidth)}; --mask-md: ${maskAt(width)}`,
    };
  }),
);
---

<div
  data-hero-item
  class="flex flex-col gap-2 border-t border-white/10 pt-4 [--logo-unit:2.25rem] md:mt-4 md:flex-row md:items-center md:gap-10 md:pt-6 md:[--logo-unit:3.5rem]"
>
  {/* Libellé en muted-1 et non en lagon : en bas du hero, le lagon descend sous 4,5:1. */}
  <p class="text-xs font-semibold tracking-widest text-muted-1 uppercase">Partenaires</p>
  {/* Mobile : logos répartis avec des écarts égaux ; à partir de md, quatre cellules identiques. */}
  <ul class="sponsors grid flex-1 grid-cols-[repeat(4,auto)] justify-between md:grid-cols-4">
    {logos.map(({ url, image, ...sponsor }, i) => {
      const Wrapper = url ? 'a' : 'div';
      const link = url ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {};
      return (
        <li class="flex justify-center" style={`--i: ${i}`}>
          {/* Zone cliquable : toute la cellule sur mobile, le logo et une marge à partir de md.
              Anneau de focus : sur le cadre du logo (voir plus bas). */}
          <Wrapper
            {...link}
            class="sponsor flex min-h-11 w-full items-center justify-center focus-visible:outline-none md:w-auto md:px-4"
          >
            {/* Cadre aux dimensions exactes du logo : repère de l'anneau de focus, du trait et de
                la mention. */}
            <span class="sponsor__frame">
              <span class="sponsor__logo">
                <img
                  src={image.src}
                  srcset={image.srcSet.attribute}
                  {...image.attributes}
                  class="sponsor__img block h-[calc(var(--logo-unit)*var(--logo-h))] w-auto object-contain"
                  style={`--logo-h: ${sponsor.h}`}
                />
                <span class="sponsor__shine" style={sponsor.mask}></span>
              </span>
              {url && (
                <span class="sponsor__label" aria-hidden="true">
                  Site officiel
                  <svg viewBox="0 0 12 12" focusable="false">
                    <path d="M3.5 8.5l5-5M4.5 3.5h4v4" />
                  </svg>
                </span>
              )}
            </span>
            {url && <span class="sr-only"> (site officiel, nouvel onglet)</span>}
          </Wrapper>
        </li>
      );
    })}
  </ul>
</div>
