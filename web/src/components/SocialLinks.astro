---
interface Props {
  class?: string;
  iconClass?: string;
  magnetic?: boolean;
}

const { class: className = '', iconClass = 'h-5 w-5', magnetic = true } = Astro.props;

const networks = [
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/share/1BhzPeJTXS/',
    path: '<path d="M13.5 9.2H15V6.4h-1.7c-2.1 0-3.3 1.3-3.3 3.4V11H8v3h2v7h3v-7h2.1l.4-3H13v-1.1c0-.8.2-1.7 1.5-1.7Z" fill="currentColor"/>',
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/gillesgambini/',
    path: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/>',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/gilles-gambini-5298a287/',
    path: '<rect x="3" y="3" width="18" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="8" cy="8.2" r="1.3" fill="currentColor"/><path d="M8 11v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M12.3 18v-4c0-1.8 1-2.8 2.4-2.8s2.1 1 2.1 2.8V18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/><path d="M12.3 11v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  },
];
---

<div class={`flex items-center gap-3 ${className}`}>
  {networks.map((n) => (
    <a
      href={n.href}
      target="_blank"
      rel="noopener"
      aria-label={n.name}
      data-magnetic={magnetic ? '' : undefined}
      class="flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-ivory transition-colors hover:border-lagon hover:text-lagon"
    >
      <svg class={iconClass} viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={n.path} />
    </a>
  ))}
</div>
