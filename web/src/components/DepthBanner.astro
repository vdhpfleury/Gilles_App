---
/*
 * Bandeau pleine largeur en tête de page, "photo en relief" : sur grand écran, motion.ts y
 * superpose le canvas WebGL de hero3d.ts (parallaxe de profondeur + caustiques) quand il approche
 * de l'écran ; l'<Image> reste le rendu de base (mobile, mouvement réduit, sans WebGL).
 * Le contenu qui suit peut remonter sur le bas du bandeau (-mt-16 md:-mt-20, jamais plus de
 * 5,5rem) : le dégradé y est à 100 % encre dès 5,5rem du bas, quelle que soit la hauteur du
 * bandeau, pour que les petits textes (sur-titre lagon : 4,9:1 sur l'encre) restent AA.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  /** Texte alternatif, en français. */
  alt: string;
  /** Carte de profondeur alignée sur la photo (blanc = proche), dans public/3d/. */
  depthSrc: string;
  widths?: number[];
  /** Hauteur du bandeau. */
  heightClass?: string;
}

const {
  image,
  alt,
  depthSrc,
  widths = [640, 1024, 1600, 2000, 2400].filter((w) => w <= image.width),
  heightClass = 'h-[44vh] min-h-64 lg:h-[56vh] lg:max-h-[640px]',
} = Astro.props;
---

<div class:list={['relative overflow-hidden', heightClass]}>
  <div data-depth-photo data-depth-src={depthSrc} class="absolute inset-0">
    <Image
      src={image}
      alt={alt}
      class="absolute inset-0 h-full w-full object-cover"
      widths={widths}
      sizes="100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  {/* Encre (#0b0f14) : léger voile en haut, photo dégagée au milieu, encre pleine en bas. */}
  <div
    class="absolute inset-0 bg-[linear-gradient(to_bottom,rgb(11_15_20/0.4),rgb(11_15_20/0.05)_35%,rgb(11_15_20/0.7)_calc(100%_-_10rem),rgb(11_15_20)_calc(100%_-_5.5rem))]"
  >
  </div>
</div>
