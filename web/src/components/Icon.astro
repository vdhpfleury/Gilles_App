---
interface Props {
  name: 'apnee' | 'biologie' | 'hyperbare' | 'conference' | 'stage' | 'contact';
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<Props['name'], string> = {
  apnee: '<path d="M2 8c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/><path d="M2 14c2-3 4-3 6 0s4 3 6 0 4-3 6 0"/>',
  biologie: '<path d="M12 3c3 3 5 6 5 9a5 5 0 0 1-10 0c0-3 2-6 5-9Z"/><path d="M12 12v9"/>',
  hyperbare: '<circle cx="12" cy="13" r="8"/><path d="M12 13l4-3"/><path d="M9 3h6"/>',
  conference: '<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v4"/><path d="M9 22h6"/>',
  stage: '<circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6 6-2Z"/>',
  contact: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
