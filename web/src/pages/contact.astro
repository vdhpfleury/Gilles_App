---
import BaseLayout from '../layouts/BaseLayout.astro';

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID as string | undefined;
const isConfigured = Boolean(formspreeId);
---

<BaseLayout title="Contact" description="Contactez Gilles Gambini pour une demande de mentoring, coaching, conférence, stage ou intervention hyperbare.">
  <section class="mx-auto grid max-w-6xl gap-12 px-6 py-16 md:grid-cols-[2fr_1fr]">
    <div>
      <h1 class="font-display mb-2 text-4xl font-semibold text-ivory">Contact</h1>
      <p class="mb-8 text-muted-1">
        Pour toute demande d'information, réservation ou projet personnalisé, n'hésitez pas à me
        contacter. Je réponds généralement sous 48h.
      </p>

      {!isConfigured && (
        <p class="mb-6 rounded-md border border-lagon/40 bg-lagon/10 p-3 text-xs text-ivory">
          Formulaire en attente de configuration (<code>PUBLIC_FORMSPREE_ID</code>) — écrivez-moi
          directement à <a href="mailto:gilles.gambini@hotmail.fr" class="underline">gilles.gambini@hotmail.fr</a>.
        </p>
      )}

      <form
        id="contact-form"
        class="flex flex-col gap-5"
        method="POST"
        action={isConfigured ? `https://formspree.io/f/${formspreeId}` : undefined}
      >
        <div aria-hidden="true" style="position: absolute; left: -9999px;">
          <label for="_gotcha">Ne pas remplir ce champ</label>
          <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="nom" class="text-xs text-muted-1">Nom complet *</label>
            <input
              id="nom"
              name="nom"
              type="text"
              required
              class="h-12 rounded-md border border-white/20 bg-white/[0.03] px-3.5 text-sm text-ivory placeholder:text-muted-2 focus:border-lagon focus:ring-2 focus:ring-lagon/30 focus:outline-none"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="text-xs text-muted-1">Email *</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="h-12 rounded-md border border-white/20 bg-white/[0.03] px-3.5 text-sm text-ivory placeholder:text-muted-2 focus:border-lagon focus:ring-2 focus:ring-lagon/30 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="telephone" class="text-xs text-muted-1">Téléphone</label>
            <input
              id="telephone"
              name="telephone"
              type="tel"
              class="h-12 rounded-md border border-white/20 bg-white/[0.03] px-3.5 text-sm text-ivory placeholder:text-muted-2 focus:border-lagon focus:ring-2 focus:ring-lagon/30 focus:outline-none"
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="sujet" class="text-xs text-muted-1">Sujet de la demande *</label>
            <select
              id="sujet"
              name="sujet"
              required
              class="h-12 rounded-md border border-white/20 bg-white/[0.03] px-3.5 text-sm text-ivory focus:border-lagon focus:ring-2 focus:ring-lagon/30 focus:outline-none"
            >
              <option>Mentoring</option>
              <option>Coaching Apnée</option>
              <option>Conférence</option>
              <option>Stage</option>
              <option>Services Hyperbare</option>
              <option>Banque d'images</option>
              <option>Cours en ligne</option>
              <option>Autre</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="text-xs text-muted-1">Votre message *</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="rounded-md border border-white/20 bg-white/[0.03] px-3.5 py-3 text-sm text-ivory placeholder:text-muted-2 focus:border-lagon focus:ring-2 focus:ring-lagon/30 focus:outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          disabled={!isConfigured}
          class="self-start rounded-sm bg-lagon px-7 py-3 text-xs font-semibold tracking-widest text-ink uppercase hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
        >
          Envoyer
        </button>
        <p id="form-status" role="status" aria-live="polite" class="text-xs text-muted-1"></p>
      </form>
    </div>

    <div class="flex flex-col gap-6">
      <div>
        <h2 class="font-display mb-3 text-lg font-semibold text-ivory">Coordonnées</h2>
        <p class="text-sm text-muted-1">
          <strong class="text-ivory">Email :</strong><br />gilles.gambini@hotmail.fr
        </p>
        <p class="mt-3 text-sm text-muted-1">
          <strong class="text-ivory">Localisation :</strong><br />Nice, Côte d'Azur, France
        </p>
        <p class="mt-3 text-sm text-muted-1">
          <strong class="text-ivory">Disponibilité :</strong><br />Interventions en France et à l'international
        </p>
      </div>
      <div>
        <h2 class="font-display mb-3 text-lg font-semibold text-ivory">Suivez-moi</h2>
        <div class="flex flex-col gap-2 text-sm">
          <a href="https://www.facebook.com/share/1BhzPeJTXS/" target="_blank" rel="noopener" class="text-muted-1 hover:text-lagon">Facebook</a>
          <a href="https://www.linkedin.com/in/gilles-gambini-5298a287/" target="_blank" rel="noopener" class="text-muted-1 hover:text-lagon">LinkedIn</a>
          <a href="https://www.instagram.com/gillesgambini/" target="_blank" rel="noopener" class="text-muted-1 hover:text-lagon">Instagram</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');

    if (form instanceof HTMLFormElement && form.action.startsWith('https://formspree.io')) {
      const status = document.getElementById('form-status');
      const submitBtn = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        submitBtn?.setAttribute('disabled', 'true');
        if (status) status.textContent = 'Envoi en cours…';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (response.ok) {
            form.reset();
            if (status) status.textContent = 'Message envoyé — je vous répondrai sous 48h.';
          } else {
            if (status) {
              status.textContent =
                "Une erreur est survenue, réessayez ou écrivez-moi directement à gilles.gambini@hotmail.fr.";
            }
          }
        } catch {
          if (status) {
            status.textContent =
              "Une erreur est survenue, réessayez ou écrivez-moi directement à gilles.gambini@hotmail.fr.";
          }
        } finally {
          submitBtn?.removeAttribute('disabled');
        }
      });
    }
  </script>
</BaseLayout>
