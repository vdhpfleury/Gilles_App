---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import heroImage from '../assets/images/hero-wave.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Accueil">
  <section class="relative overflow-hidden">
    <Image
      src={heroImage}
      alt="Gilles Gambini en apnée, émergeant sous une vague"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/40 to-ink/95"></div>
    <div class="relative mx-auto flex min-h-[70vh] max-w-6xl flex-col justify-end gap-6 px-6 py-20">
      <p class="text-sm font-semibold tracking-widest text-lagon uppercase">
        Apnéiste professionnel · Biologiste marin
      </p>
      <h1 class="font-display max-w-2xl text-5xl font-semibold text-ivory md:text-6xl">
        Gilles Gambini
      </h1>
      <p class="max-w-xl text-base leading-relaxed text-muted-1">
        Instructeur, plongeur scientifique, scaphandrier et photographe. Un accompagnement entre
        science, exploration et performance pour repousser vos limites en milieu marin.
      </p>
      <div>
        <a
          href="/contact"
          class="inline-block rounded-sm bg-lagon px-7 py-3 text-xs font-semibold tracking-widest text-ink uppercase hover:opacity-90"
        >
          Me contacter
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="font-display mb-10 text-3xl font-semibold text-ivory">Mes services</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a
          href={`/services/${service.id}`}
          class="group flex flex-col gap-4 rounded-lg border border-white/15 bg-white/[0.03] p-6 transition hover:border-lagon"
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-lagon">
            <Icon name={service.data.icon} />
          </span>
          <h3 class="font-display text-lg font-semibold text-ivory">{service.data.title}</h3>
          <p class="text-sm text-muted-1">{service.data.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <blockquote class="border-l-4 border-lagon bg-white/[0.03] p-8 font-display text-xl italic text-ivory">
      « Chaque stage est une expérience humaine et sensorielle. On apprend à mieux respirer, à
      mieux comprendre… et à mieux vivre. »
    </blockquote>
  </section>
</BaseLayout>
