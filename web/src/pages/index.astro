---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Carousel from '../components/Carousel.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import SocialLinks from '../components/SocialLinks.astro';
import DepthGauge from '../components/DepthGauge.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import heroImage from '../assets/images/hero-wave.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const galleryImages = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/accueil/*.jpg', { eager: true }),
).map((mod) => ({ src: mod.default, alt: 'Gilles Gambini — expéditions et moments forts' }));

const interviews = [
  { videoId: 'Qf6NSbwm6iw', title: 'Interview France 3', caption: 'France 3' },
  { videoId: 'Uz1VxVH-iyY', title: 'Interview Université Côte d’Azur', caption: 'Université Côte d’Azur' },
  { videoId: 'gvhg9zYuwpc', title: 'Interview Pure Ocean', caption: 'Pure Ocean' },
];

// « La descente » : bulles du calque d'eau (cf. src/scripts/descent.ts), qui disparaissent
// avec la profondeur en commençant par les dernières. Valeurs figées (pseudo-aléatoire
// déterministe) pour un rendu identique à chaque build.
const bubbles = Array.from({ length: 14 }, (_, i) => {
  const rand = (k: number) => {
    const x = Math.sin((i + 1) * 12.9898 + k * 78.233) * 43758.5453;
    return x - Math.floor(x);
  };
  return {
    left: (3 + ((i * 41 + rand(1) * 9) % 94)).toFixed(1),
    size: (3 + rand(2) * 6).toFixed(1),
    rise: (18 + rand(3) * 16).toFixed(1),
    delay: (-rand(4) * 34).toFixed(1),
  };
});

const depthSections = [
  { id: 'services', label: 'Services' },
  { id: 'images', label: 'En images' },
  { id: 'interviews', label: 'Interviews' },
];
---

<BaseLayout title="Accueil">
  <section data-hero class="relative overflow-hidden">
    {/* Légèrement agrandie (scale) pour que le parallaxe ne découvre jamais un bord. */}
    <Image
      src={heroImage}
      alt="Gilles Gambini en apnée, émergeant sous une vague"
      data-parallax
      class="absolute inset-0 h-full w-full scale-[1.1] object-cover"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/55 to-ink/95"></div>
    <div class="relative mx-auto flex min-h-[70vh] max-w-6xl flex-col justify-end gap-6 px-6 py-20">
      <p data-hero-item class="text-sm font-semibold tracking-widest text-lagon uppercase [text-shadow:0_1px_10px_rgb(0_0_0/0.85)]">
        Apnéiste professionnel · Biologiste marin
      </p>
      <h1 data-hero-item class="font-display max-w-2xl text-5xl font-semibold text-ivory md:text-6xl">
        Gilles Gambini
      </h1>
      <p data-hero-item class="max-w-xl text-base leading-relaxed text-muted-1">
        Instructeur, plongeur scientifique, scaphandrier et photographe. Un accompagnement entre
        science, exploration et performance pour repousser vos limites en milieu marin.
      </p>
      <div data-hero-item class="flex flex-wrap items-center gap-x-4 gap-y-4 sm:gap-x-6">
        <a
          href="/contact"
          data-magnetic
          class="inline-block rounded-sm bg-lagon px-6 py-3 text-xs font-semibold tracking-widest text-ink uppercase transition-colors hover:bg-ivory sm:px-7"
        >
          Me contacter
        </a>
        <SocialLinks />
      </div>
    </div>
  </section>

  <section data-depth-section="services" class="mx-auto max-w-6xl px-6 py-20">
    <h2 data-reveal class="font-display mb-10 text-3xl font-semibold text-ivory">Mes services</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <a
          href={`/services/${service.id}`}
          data-reveal
          data-tilt
          class="group flex flex-col gap-4 rounded-lg border border-white/15 bg-white/[0.03] p-6 transition-[border-color,box-shadow] duration-300 hover:border-lagon hover:shadow-[0_24px_60px_-28px_rgb(79_138_141/0.55)]"
        >
          <span class="flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-lagon transition-colors duration-300 group-hover:border-lagon/60 group-hover:bg-lagon/10">
            <Icon name={service.data.icon} />
          </span>
          <h3 class="font-display text-lg font-semibold text-ivory">{service.data.title}</h3>
          <p class="text-sm text-muted-1">{service.data.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <blockquote data-reveal class="border-l-4 border-lagon bg-white/[0.03] p-8 font-display text-xl italic text-ivory">
      « Chaque stage est une expérience humaine et sensorielle. On apprend à mieux respirer, à
      mieux comprendre… et à mieux vivre. »
    </blockquote>
  </section>

  <section data-depth-section="images" class="mx-auto max-w-6xl px-6 pb-20">
    <h2 data-reveal class="font-display mb-10 text-3xl font-semibold text-ivory">En images</h2>
    <div data-reveal>
      <Carousel id="accueil" images={galleryImages} height="480px" duration={3.5} />
    </div>
  </section>

  <section data-depth-section="interviews" class="mx-auto max-w-6xl px-6 pb-20">
    <h2 data-reveal class="font-display mb-10 text-3xl font-semibold text-ivory">Quelques interviews</h2>
    <div class="grid gap-8 sm:grid-cols-3">
      {interviews.map((video) => (
        <div data-reveal class="flex flex-col gap-3">
          <YoutubeEmbed videoId={video.videoId} title={video.title} />
          <p class="text-center text-sm italic text-muted-1">{video.caption}</p>
        </div>
      ))}
    </div>
  </section>

  {/* « La descente » : eau fixe derrière le contenu et jauge de profondeur, décoratives.
      Sans JavaScript, rien ne s'affiche (cf. global.css). */}
  <div class="descent" aria-hidden="true">
    <div class="descent__layer" data-descent>
      <div class="descent__water" data-descent-water></div>
      <div class="descent__glow" data-descent-glow></div>
      <div class="descent__bubbles" data-descent-bubbles>
        {bubbles.map((b) => (
          <span
            class="descent__bubble"
            style={`left: ${b.left}%; --size: ${b.size}px; --rise: ${b.rise}s; --delay: ${b.delay}s;`}
          ></span>
        ))}
      </div>
    </div>
  </div>
  <DepthGauge sections={depthSections} />
</BaseLayout>

<script>
  import '../scripts/descent.ts';
</script>
