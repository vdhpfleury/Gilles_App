---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingCard from '../../components/PricingCard.astro';
import Carousel from '../../components/Carousel.astro';
import DepthBanner from '../../components/DepthBanner.astro';
import { getCollection, render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import stageGlaceHeader from '../../assets/images/stage-glace-header.jpg';

export async function getStaticPaths() {
  const stages = await getCollection('stages');
  return stages.map((stage) => ({
    params: { id: stage.id },
    props: { stage },
  }));
}

const { stage } = Astro.props;
const { Content } = await render(stage);

const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/gallery/*/*.jpg',
  { eager: true },
);

function galleryFor(folder: string) {
  return Object.entries(galleryModules)
    .filter(([path]) => path.includes(`/gallery/${folder}/`))
    .map(([, mod]) => ({ src: mod.default, alt: `${stage.data.title} — photo` }));
}

// Chaque stage peut afficher une petite galerie tournante liée à sa thématique.
const galleryByStage: Record<string, { src: ImageMetadata; alt: string }[]> = {
  'apnee-sous-glace': galleryFor('stage-ice'),
  'apnee-debutant': galleryFor('stage-apnee'),
  'apnee-avance': galleryFor('stage-apnee'),
  'plongee-scientifique': galleryFor('scientifique'),
};

const gallery = galleryByStage[stage.id];

// Bandeau "photo en relief" en tête de certains stages (photo + carte de profondeur alignée,
// blanc = proche, dans public/3d/ ; voir data-depth-photo dans src/scripts/motion.ts).
const headerByStage: Record<string, { src: ImageMetadata; alt: string; depthSrc: string }> = {
  'apnee-sous-glace': {
    src: stageGlaceHeader,
    alt: 'Apnéiste glissant entre deux parois de glace, sous la banquise',
    depthSrc: '/3d/stage-glace-header-depth.webp',
  },
};

const header = headerByStage[stage.id];
---

<BaseLayout title={stage.data.title}>
  {header && <DepthBanner image={header.src} alt={header.alt} depthSrc={header.depthSrc} />}
  <section class:list={['mx-auto max-w-4xl px-6', header ? 'relative -mt-16 pb-16 md:-mt-20' : 'py-16']}>
    <div data-reveal>
      <p class="text-sm font-semibold tracking-widest text-lagon uppercase">{stage.data.niveau}</p>
      <h1 class="font-display mt-2 mb-8 text-4xl font-semibold text-ivory">{stage.data.title}</h1>
    </div>

    <div data-reveal class="prose prose-invert max-w-none text-muted-1 prose-headings:font-display prose-headings:text-ivory prose-strong:text-ivory">
      <Content />
    </div>

    {gallery && gallery.length > 0 && (
      <div data-reveal class="mt-10">
        <Carousel id={stage.id} images={gallery} height="360px" duration={4} />
      </div>
    )}

    {stage.data.prerequis && (
      <p data-reveal class="mt-8 rounded-lg border border-lagon/40 bg-lagon/10 p-4 text-sm text-ivory">
        <strong>Pré-requis :</strong> {stage.data.prerequis}
      </p>
    )}

    {stage.data.formules.length > 0 && (
      <div class="mt-12">
        <h2 data-reveal class="font-display mb-6 text-2xl font-semibold text-ivory">Formules</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {stage.data.formules.map((formule) => (
            <PricingCard titre={formule.titre} description={formule.description} prix={formule.prix} />
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
