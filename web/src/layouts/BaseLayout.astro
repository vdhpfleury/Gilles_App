---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Exclut la page des moteurs de recherche (pages de démonstration non publiques). */
  noindex?: boolean;
}

const {
  title,
  description = "Apnéiste professionnel, biologiste marin et plongeur scientifique.",
  image = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const pageTitle = `${title} · Gilles Gambini`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/services', label: 'Services' },
  { href: '/stages', label: 'Stages' },
  { href: '/qui-suis-je', label: 'Qui suis-je' },
];
const mobileLinks = [...navLinks, { href: '/contact', label: 'Contact' }];

// Lien actif : correspondance exacte pour l'accueil, par préfixe pour les
// rubriques (ex. /services/mentoring active "Services").
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Signale que JS est actif avant le premier rendu : le hero et les blocs [data-reveal]
        peuvent être masqués le temps de leur animation d'entrée (cf. global.css), sans
        que rien ne soit masqué quand JS est désactivé. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="font-sans bg-ink text-ivory min-h-screen flex flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded focus:bg-lagon focus:px-4 focus:py-2 focus:text-ink"
    >
      Aller au contenu
    </a>

    <header class="relative z-40 border-b border-white/10">
      <nav
        aria-label="Navigation principale"
        class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-5"
      >
        <a href="/" class="font-display text-lg font-semibold tracking-wide uppercase">
          Gilles Gambini
        </a>
        <ul class="hidden gap-8 text-sm md:flex">
          {navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'nav-link transition-colors duration-300 hover:text-lagon',
                    active ? 'text-ivory' : 'text-muted-1',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
        <div class="flex items-center gap-3">
          <a
            href="/contact"
            data-magnetic
            class="hidden rounded-sm bg-lagon px-5 py-2.5 text-xs font-semibold tracking-widest text-ink uppercase transition-colors hover:bg-ivory sm:inline-block"
          >
            Me contacter
          </a>
          <button
            type="button"
            class="menu-toggle h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-ivory transition-colors hover:border-lagon hover:text-lagon"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Menu"
            data-menu-toggle
          >
            <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
          </button>
        </div>
      </nav>

      <div id="mobile-menu" class="mobile-menu md:hidden" data-open="false">
        <div class="mobile-menu__inner">
          <ul class="mx-auto flex max-w-6xl flex-col px-6 pt-2 pb-8">
            {mobileLinks.map((link, i) => {
              const active = isActive(link.href);
              return (
                <li style={`--i: ${i}`}>
                  <a
                    href={link.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'flex items-baseline gap-4 border-b border-white/10 py-3.5 font-display text-2xl transition-colors hover:text-lagon',
                      active ? 'text-lagon' : 'text-ivory',
                    ]}
                  >
                    <span class="font-sans text-xs text-muted-2 tabular-nums" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </header>

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <footer class="mt-auto border-t border-white/10 py-8">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6">
        <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
          <SocialLinks magnetic={false} />
          <a href="/mentions-legales" class="text-xs text-muted-2 transition-colors hover:text-lagon">
            Mentions légales
          </a>
        </div>
        <div class="flex flex-col items-center justify-between gap-2 text-center text-xs text-muted-2 md:flex-row md:text-left">
          <p>© {new Date().getFullYear()} Gilles Gambini</p>
          <p>Toutes les photos sont soumises aux droits d'auteur. Me contacter pour toute utilisation.</p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/motion.ts';
    </script>

    <script>
      // Menu mobile : bouton disclosure (aria-expanded) + panneau animé en CSS.
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.getElementById('mobile-menu');

      if (toggle && menu) {
        const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          menu.dataset.open = String(open);
        };

        toggle.addEventListener('click', () => setOpen(!isOpen()));

        // Fermeture au clic sur un lien du menu.
        menu.addEventListener('click', (event) => {
          if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
        });

        // Fermeture avec Échap, en rendant le focus au bouton.
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && isOpen()) {
            setOpen(false);
            toggle.focus();
          }
        });

        // Fermeture au clic en dehors de l'en-tête.
        document.addEventListener('click', (event) => {
          if (isOpen() && event.target instanceof Node && !toggle.closest('header')?.contains(event.target)) {
            setOpen(false);
          }
        });

        // Repasse en fermé si la fenêtre s'élargit au format desktop.
        window.matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
          if (event.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>
