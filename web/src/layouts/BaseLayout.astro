---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Apnéiste professionnel, biologiste marin et plongeur scientifique.",
  image = '/og-default.jpg',
} = Astro.props;

const pageTitle = `${title} · Gilles Gambini`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="font-sans bg-ink text-ivory min-h-screen flex flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded focus:bg-lagon focus:px-4 focus:py-2 focus:text-ink"
    >
      Aller au contenu
    </a>

    <header class="border-b border-white/10">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/" class="font-display text-lg font-semibold tracking-wide uppercase">
          Gilles Gambini
        </a>
        <ul class="hidden gap-8 text-sm md:flex">
          <li><a href="/" class="hover:text-lagon">Accueil</a></li>
          <li><a href="/services" class="text-muted-1 hover:text-lagon">Services</a></li>
          <li><a href="/stages" class="text-muted-1 hover:text-lagon">Stages</a></li>
          <li><a href="/qui-suis-je" class="text-muted-1 hover:text-lagon">Qui suis-je</a></li>
        </ul>
        <a
          href="/contact"
          class="rounded-sm bg-lagon px-5 py-2.5 text-xs font-semibold tracking-widest text-ink uppercase hover:opacity-90"
        >
          Me contacter
        </a>
      </nav>
    </header>

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <footer class="mt-auto border-t border-white/10 px-6 py-6">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 text-xs text-muted-2 md:flex-row">
        <p>© {new Date().getFullYear()} Gilles Gambini</p>
        <p>Toutes les photos sont soumises aux droits d'auteur. Me contacter pour toute utilisation.</p>
        <a href="/mentions-legales" class="hover:text-lagon">Mentions légales</a>
      </div>
    </footer>
  </body>
</html>
